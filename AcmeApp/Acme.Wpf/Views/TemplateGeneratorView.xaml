<Window x:Class="Acme.Wpf.Views.TemplateGeneratorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Acme.Wpf.Views"
        xmlns:vm="clr-namespace:Acme.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Spiritual Template Generator" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Window.DataContext>
        <vm:TemplateGeneratorViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="#FFD700"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings Panel -->
        <Border Grid.Column="0" Background="#16213e" BorderBrush="#FFD700" BorderThickness="0,0,2,0" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="TEMPLATE GENERATOR"
                              FontSize="20"
                              FontWeight="Bold"
                              Foreground="#FFD700"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,20"/>

                    <!-- Page Format Section -->
                    <TextBlock Text="PAGE FORMAT" Style="{StaticResource HeaderTextStyle}"/>
                    <Separator Background="#FFD700" Margin="0,0,0,10"/>

                    <TextBlock Text="Format:" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox ItemsSource="{Binding PageFormats}"
                             SelectedItem="{Binding SelectedPageFormat}"
                             DisplayMemberPath="DisplayName"
                             Style="{StaticResource ComboBoxStyle}"/>

                    <!-- Color Scheme Section -->
                    <TextBlock Text="COLOR SCHEME" Style="{StaticResource HeaderTextStyle}"/>
                    <Separator Background="#FFD700" Margin="0,0,0,10"/>

                    <TextBlock Text="Scheme:" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox ItemsSource="{Binding ColorSchemes}"
                             SelectedItem="{Binding SelectedColorScheme}"
                             DisplayMemberPath="Name"
                             Style="{StaticResource ComboBoxStyle}"/>

                    <!-- Frame Section -->
                    <TextBlock Text="FRAME STYLE" Style="{StaticResource HeaderTextStyle}"/>
                    <Separator Background="#FFD700" Margin="0,0,0,10"/>

                    <TextBlock Text="Style:" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox ItemsSource="{Binding FrameStyles}"
                             SelectedItem="{Binding SelectedFrameStyle}"
                             Style="{StaticResource ComboBoxStyle}"/>

                    <TextBlock Text="Frame Thickness:" Style="{StaticResource LabelTextStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="200"
                               Minimum="10"
                               Maximum="100"
                               Value="{Binding FrameThickness}"
                               TickFrequency="5"
                               Style="{StaticResource SliderStyle}"/>
                        <TextBlock Text="{Binding FrameThickness, StringFormat={}{0:F0}}"
                                  Foreground="#E8E8E8"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Sacred Geometry Section -->
                    <TextBlock Text="SACRED GEOMETRY" Style="{StaticResource HeaderTextStyle}"/>
                    <Separator Background="#FFD700" Margin="0,0,0,10"/>

                    <TextBlock Text="Geometry Type:" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox ItemsSource="{Binding GeometryTypes}"
                             SelectedItem="{Binding SelectedGeometryType}"
                             Style="{StaticResource ComboBoxStyle}"/>

                    <TextBlock Text="Size:" Style="{StaticResource LabelTextStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="200"
                               Minimum="50"
                               Maximum="500"
                               Value="{Binding GeometrySize}"
                               TickFrequency="10"
                               Style="{StaticResource SliderStyle}"/>
                        <TextBlock Text="{Binding GeometrySize, StringFormat={}{0:F0}}"
                                  Foreground="#E8E8E8"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Opacity:" Style="{StaticResource LabelTextStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="200"
                               Minimum="0.1"
                               Maximum="1.0"
                               Value="{Binding GeometryOpacity}"
                               TickFrequency="0.1"
                               Style="{StaticResource SliderStyle}"/>
                        <TextBlock Text="{Binding GeometryOpacity, StringFormat={}{0:F2}}"
                                  Foreground="#E8E8E8"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Add Geometry"
                               Command="{Binding AddGeometryCommand}"
                               Style="{StaticResource ButtonStyle}"/>
                        <Button Content="Clear All"
                               Command="{Binding ClearGeometryCommand}"
                               Style="{StaticResource ButtonStyle}"/>
                    </StackPanel>

                    <!-- Effects Section -->
                    <TextBlock Text="EFFECTS" Style="{StaticResource HeaderTextStyle}"/>
                    <Separator Background="#FFD700" Margin="0,0,0,10"/>

                    <CheckBox Content="Show Stars"
                             IsChecked="{Binding ShowStars}"
                             Style="{StaticResource CheckBoxStyle}"/>
                    <CheckBox Content="Gradient Overlay"
                             IsChecked="{Binding ShowGradientOverlay}"
                             Style="{StaticResource CheckBoxStyle}"/>

                    <!-- Action Buttons -->
                    <TextBlock Text="ACTIONS" Style="{StaticResource HeaderTextStyle}"/>
                    <Separator Background="#FFD700" Margin="0,0,0,10"/>

                    <Button Content="Generate Preview"
                           Command="{Binding GeneratePreviewCommand}"
                           Style="{StaticResource ButtonStyle}"
                           Width="Auto"
                           HorizontalAlignment="Stretch"/>
                    <Button Content="Export SVG"
                           Command="{Binding ExportSvgCommand}"
                           Style="{StaticResource ButtonStyle}"
                           Width="Auto"
                           HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Preview Panel -->
        <Grid Grid.Column="1" Background="#0f0f1e">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Preview Header -->
            <Border Grid.Row="0" Background="#16213e" BorderBrush="#FFD700" BorderThickness="0,0,0,2" Padding="20">
                <StackPanel>
                    <TextBlock Text="PREVIEW"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="#FFD700"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Your spiritual template will appear below"
                              FontSize="12"
                              Foreground="#B8B8B8"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Preview Area -->
            <ScrollViewer Grid.Row="1"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Background="#0f0f1e">
                <Border Margin="20"
                       BorderBrush="#FFD700"
                       BorderThickness="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <WebBrowser x:Name="PreviewBrowser"
                               Width="800"
                               Height="600"
                               Loaded="PreviewBrowser_Loaded"/>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
