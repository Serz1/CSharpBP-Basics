<Window x:Class="Acme.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acme Applications Launcher"
        Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#16213e" BorderBrush="#FFD700" BorderThickness="0,0,0,2" Padding="20">
            <StackPanel>
                <TextBlock Text="ACME APPLICATIONS"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="#FFD700"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Choose an application to launch"
                          FontSize="12"
                          Foreground="#B8B8B8"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <Button Content="Spiritual Template Generator"
                   Click="LaunchTemplateGenerator_Click"
                   Style="{StaticResource LauncherButtonStyle}"
                   Margin="10"/>
            <Button Content="Vendor Management"
                   Click="LaunchVendorManagement_Click"
                   Style="{StaticResource LauncherButtonStyle}"
                   Margin="10"/>
        </StackPanel>
    </Grid>

    <Window.Resources>
        <Style x:Key="LauncherButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="40,20"/>
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>